{
  "experiment_name": "federated_cifar10_dirichlet_scu_public_compensation_smoke",
  "device": "cpu",
  "deterministic": true,
  "dataset": {
    "name": "CIFAR10",
    "data_root": "data/cifar10",
    "download": false
  },
  "public_data": {
    "samples_per_class": 2,
    "seed": 17
  },
  "codec": {
    "latent_dim": 4,
    "base_channels": 4,
    "activation": "relu",
    "logvar_min": -8.0,
    "logvar_max": 4.0,
    "epsilon_power": 1e-08
  },
  "federation": {
    "n_clients": 10,
    "samples_per_client": 18,
    "rounds": 1,
    "local_epochs": 1
  },
  "split": {
    "type": "equal_size_dirichlet",
    "alpha": 0.1,
    "seed": 0
  },
  "training": {
    "batch_size": 18,
    "learning_rate": 0.001,
    "beta": 0.0001,
    "snr_db": 10.0
  },
  "unlearning": {
    "mode": "scu_public_compensation",
    "target_client_id": 0,
    "forgetting_epochs": 1,
    "lambda_kl": 1.0,
    "lambda_rec": 0.1,
    "erased_buffer_max_examples": 18,
    "server_cc_epochs": 1,
    "server_cc_learning_rate": 0.001,
    "contrastive_temperature": 0.2,
    "lambda_contrastive": 1.0,
    "lambda_public_reconstruction": 1.0
  },
  "evaluation": {
    "batch_size": 20
  }
}
