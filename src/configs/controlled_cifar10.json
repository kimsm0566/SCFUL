{
  "experiment_name": "controlled_cifar10_behavior",
  "device": "auto",
  "deterministic": true,
  "dataset": {
    "name": "CIFAR10",
    "data_root": "data/cifar10",
    "download": true,
    "transform": "ToTensor"
  },
  "codec": {
    "architecture": "variational_deepjscc_cifar10_v2",
    "latent_dim": 256,
    "latent_channels": 4,
    "logvar_min": -8.0,
    "logvar_max": 4.0,
    "epsilon_power": 1e-08,
    "kl_reduction": "elementwise_mean"
  },
  "split": {
    "shared_labels": [3, 4, 5, 6],
    "shared_per_label": 1500,
    "target_specific_label": 1,
    "retained_clients": 4
  },
  "audit": {
    "target_per_group": 256,
    "retained_total": 2000
  },
  "training": {
    "epochs": 200,
    "batch_size": 128,
    "learning_rate": 0.0001,
    "beta": 0.0001,
    "snr_db": 10.0,
    "num_workers": 0
  },
  "scu": {
    "epochs": 200,
    "batch_size": 128,
    "learning_rate": 0.0001,
    "lambda_kl": 1.0,
    "lambda_rec": 0.1,
    "lambda_ss": 1.0,
    "beta": 0.0001,
    "epsilon": 1e-08,
    "snr_db": 10.0,
    "num_workers": 0,
    "optimizer_state": "new_adam_from_original_checkpoint",
    "retained_sampling": "shuffled_without_replacement_then_recycle"
  },
  "evaluation": {
    "batch_size": 256,
    "awgn_snr_db": 10.0,
    "awgn_repetitions": 8,
    "bootstrap_resamples": 1000,
    "figure_probes_per_group": 4
  },
  "client_posterior": {
    "fit_fraction": 0.8,
    "batch_size": 256,
    "minimum_variance": 1e-06,
    "mmd_sample_limit": 512,
    "bootstrap_resamples": 200,
    "bootstrap_sample_size": 256
  }
}
