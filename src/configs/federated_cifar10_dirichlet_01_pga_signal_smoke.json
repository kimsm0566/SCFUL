{
  "experiment_name": "federated_cifar10_dirichlet_pga_local_signal_smoke",
  "device": "cpu",
  "deterministic": true,
  "dataset": {
    "name": "CIFAR10",
    "data_root": "data/cifar10",
    "download": false
  },
  "codec": {
    "latent_dim": 4,
    "base_channels": 4,
    "activation": "relu",
    "logvar_min": -8.0,
    "logvar_max": 4.0,
    "epsilon_power": 1e-08
  },
  "federation": {
    "n_clients": 10,
    "samples_per_client": 20,
    "rounds": 1,
    "local_epochs": 1
  },
  "split": {
    "type": "equal_size_dirichlet",
    "alpha": 0.1,
    "seed": 0
  },
  "training": {
    "batch_size": 20,
    "learning_rate": 0.001,
    "beta": 0.0001,
    "snr_db": 10.0
  },
  "unlearning": {
    "mode": "pga_local_signal",
    "target_client_id": 0,
    "pga_epochs": 1,
    "pga_learning_rate": 0.01,
    "pga_momentum": 0.0,
    "pga_projection_radius_multiplier": 2.0
  },
  "evaluation": {
    "batch_size": 20
  }
}
