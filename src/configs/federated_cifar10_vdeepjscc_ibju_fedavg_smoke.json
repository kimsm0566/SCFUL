    "method_label": "IBJU_FedAvg",
    "target_client_id": 0,
    "canonical_latent": "normalized_posterior_mean",
    "forgetting_objective": "prior_kl_collapse",
    "forgetting_epochs": 2,
    "target_information_ratio_threshold": 0.01,
    "lambda_kl": 1.0,
    "lambda_rec": 0.1,
