{
  "experiment_name": "federated_cifar10_vdeepjscc_ibju_fedavg_smoke",
  "device": "cuda:0",
  "deterministic": true,
  "task": "reconstruction",
  "model": {"kind": "variational_deepjscc"},
  "dataset": {"name": "CIFAR10", "data_root": "data/cifar10", "download": false},
