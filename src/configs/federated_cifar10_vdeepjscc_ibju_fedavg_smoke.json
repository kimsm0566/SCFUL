    "lambda_repair_semantic": 0.0,
    "lambda_output_kd": 0.0,
    "lambda_feature_kd": 0.0,
    "primary_repair_variant": "normal_repair",
    "repair_aggregation": "sample_weighted_fedavg",
    "run_repair_ablations": false
