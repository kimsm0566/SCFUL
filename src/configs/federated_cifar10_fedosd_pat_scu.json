{
  "experiment_name": "federated_cifar10_fedosd_balanced_pathological_centralized_full_scu",
  "device": "cuda:0",
  "deterministic": true,
  "dataset": {
    "name": "CIFAR10",
    "data_root": "data/cifar10",
    "download": false
  },
  "codec": {
    "latent_dim": 64,
    "base_channels": 32,
    "activation": "relu",
    "logvar_min": -8.0,
    "logvar_max": 4.0,
    "epsilon_power": 1e-08
  },
  "federation": {
    "n_clients": 10,
    "samples_per_client": 5000,
    "rounds": 200,
    "local_epochs": 1
  },
  "split": {
    "type": "fedosd_balanced_pathological",
    "classes_per_client": 2,
    "seed": 1
  },
  "training": {
    "batch_size": 200,
    "learning_rate": 0.0001,
    "beta": 0.0001,
    "snr_db": 10.0
  },
  "unlearning": {
    "mode": "centralized_full_scu",
    "target_client_id": 0,
    "scu_epochs": 200,
    "lambda_kl": 1.0,
    "lambda_rec": 0.1,
    "lambda_ss": 1.0,
    "epsilon": 1e-08
  },
  "evaluation": {
    "batch_size": 256
  }
}
