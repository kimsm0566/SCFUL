{
  "experiment_name": "federated_cifar10_equal_size_dirichlet_01_cuda_pilot",
  "device": "cuda:0",
  "deterministic": true,
  "dataset": {
    "name": "CIFAR10",
    "data_root": "data/cifar10",
    "download": false
  },
  "codec": {
    "latent_dim": 64,
    "base_channels": 32,
    "activation": "relu",
    "logvar_min": -8.0,
    "logvar_max": 4.0,
    "epsilon_power": 1e-08
  },
  "federation": {
    "n_clients": 10,
    "samples_per_client": 5000,
    "rounds": 1,
    "local_epochs": 1
  },
  "split": {
    "alpha": 0.1,
    "seed": 0
  },
  "training": {
    "batch_size": 128,
    "learning_rate": 0.0001,
    "beta": 0.0001,
    "snr_db": 10.0
  },
  "unlearning": {
    "target_client_id": 0,
    "forgetting_epochs": 1,
    "repair_rounds": 1,
    "repair_epochs": 1,
    "lambda_kl": 1.0,
    "lambda_rec": 0.1,
    "lambda_distill": 0.0
  },
  "evaluation": {
    "batch_size": 256
  }
}
