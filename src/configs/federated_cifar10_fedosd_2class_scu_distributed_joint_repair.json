{
  "experiment_name": "federated_cifar10_fedosd_2class_scu_distributed_joint_repair",
  "device": "cuda:0",
  "deterministic": true,
  "dataset": {
    "name": "CIFAR10",
    "data_root": "data/cifar10",
    "download": false
  },
  "codec": {
    "latent_dim": 64,
    "base_channels": 32,
    "activation": "relu",
    "logvar_min": -8.0,
    "logvar_max": 4.0,
    "epsilon_power": 1e-08
  },
  "federation": {
    "n_clients": 10,
    "samples_per_client": 5000,
    "rounds": 200,
    "local_epochs": 1
  },
  "split": {
    "type": "fedosd_balanced_pathological",
    "classes_per_client": 2,
    "seed": 0
  },
  "training": {
    "batch_size": 200,
    "learning_rate": 0.0001,
    "beta": 0.0001,
    "reconstruction_weight": 30.0,
    "semantic_weight": 0.03333333333333333,
    "snr_db": 20.0
  },
  "unlearning": {
    "mode": "scu_distributed_joint_repair",
    "target_client_id": 0,
    "forgetting_epochs": 5,
    "lambda_kl": 1.0,
    "lambda_rec": 0.1,
    "distributed_repair_rounds": 1,
    "local_repair_epochs": 1,
    "local_repair_learning_rate": 0.0001,
    "lambda_repair_reconstruction": 20.0,
    "lambda_repair_kl": 0.0001,
    "lambda_repair_distill": 0.0
  },
  "backdoor": {
    "protocol": "scu_cifar10",
    "poison_ratio": 0.06,
    "base_label": 1,
    "trigger_label": 2,
    "evaluation_snr_db": 20.0,
    "probe_max_examples": 1000
  },
  "evaluation": {
    "batch_size": 256
  }
}
