new file mode 100644
--- /dev/null
+++ b/tests/test_torchvision_compatibility.py
@@ -0,0 +1,36 @@
+import ast
+from pathlib import Path
+import unittest
+
+
+SCRIPT_PATH = (
+    Path(__file__).resolve().parents[1]
+    / "Semantic_c_unlearning"
+    / "On_MNIST"
+    / "Unlearning_Semantic_VAE_on_Backdoor.py"
+)
+
+
+class TorchvisionCompatibilityTests(unittest.TestCase):
+    def test_make_grid_calls_do_not_pass_unsupported_cmap_keyword(self):
+        tree = ast.parse(SCRIPT_PATH.read_text(encoding="utf-8"))
+        violations = []
+
+        for node in ast.walk(tree):
+            if not isinstance(node, ast.Call):
+                continue
+
+            if not (
+                isinstance(node.func, ast.Attribute)
+                and node.func.attr == "make_grid"
+            ):
+                continue
+
+            if any(keyword.arg == "cmap" for keyword in node.keywords):
+                violations.append(node.lineno)
+
+        self.assertEqual(violations, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
